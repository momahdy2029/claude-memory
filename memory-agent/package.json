{
  "name": "claude-memory-agent",
  "version": "3.2.0",
  "description": "Persistent semantic memory for Claude Code with session recovery, self-reported learning, soul layer, and anti-hallucination grounding",
  "keywords": [
    "claude",
    "claude-code",
    "memory",
    "ai",
    "mcp",
    "semantic-search",
    "embeddings",
    "ollama"
  ],
  "author": "Claude Memory Agent Contributors",
  "license": "MIT",
  "bin": {
    "claude-memory-agent": "./bin/cli.js",
    "claude-memory": "./bin/cli.js"
  },
  "files": [
    "bin/",
    "services/",
    "skills/",
    "hooks/",
    "*.py",
    "*.md",
    "*.txt",
    "*.html",
    ".env.example",
    "!**/__pycache__/",
    "!**/*.pyc",
    "!test_*.py",
    "!verify_db.py"
  ],
  "scripts": {
    "postinstall": "node bin/postinstall.js",
    "start": "python main.py",
    "install-agent": "python install.py --auto",
    "test": "python -m pytest"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "preferGlobal": true,
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "gradient-string": "^2.0.2",
    "ora": "^5.4.1"
  }
}
